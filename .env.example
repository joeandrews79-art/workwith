# --- WorkWith environment ---
# Copy this file to `.env` and fill in values. NEVER commit `.env`.

# Supabase Postgres. Use the pooled (Transaction, port 6543) URI for DATABASE_URL,
# and the direct/session (port 5432) URI for DIRECT_URL. The Supabase "Connect"
# dialog (ORMs -> Prisma) gives both. See docs/deploy.md.
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# Secret used to sign session cookies. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: enables the Claude question-authoring assistant (admin only).
ANTHROPIC_API_KEY=""
