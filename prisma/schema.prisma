// WorkWith data model.
//
// Local prototype: SQLite (zero setup). For production, change `provider` to
// "postgresql" and point DATABASE_URL at Supabase. Notes on the swap:
//   - `role` and `status` are Strings here because SQLite has no enums. In
//     Postgres you may promote them to real enums.
//   - JSON payloads (responses / scores / narrative) are stored as String
//     (TEXT) for portability; in Postgres you may switch these to Json.
// See README "From local prototype to hosted app".

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the rhel target is what Netlify's Linux functions need.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (transaction) connection, used at runtime
  directUrl = env("DIRECT_URL") // direct/session connection, used for migrations & seed
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
  teams     Team[]
}

model Team {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime     @default(now())
  members   TeamMember[]
  meetings  Meeting[]

  @@index([orgId])
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Per-team role. A person can LEAD one team and be a plain MEMBER of another,
  // so this lives on the membership, not the user. Org-level admins (User.role
  // = ADMIN) can manage every team regardless of this value.
  role   String @default("MEMBER") // LEADER | MEMBER

  @@unique([teamId, userId])
  @@index([userId])
}

model User {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String       @unique
  name         String
  title        String? // job title, e.g. "Head of Operations"
  passwordHash String
  role         String       @default("MEMBER") // ADMIN | MEMBER
  mustReset    Boolean      @default(false) // force password change on first login
  createdAt    DateTime     @default(now())
  onboardedAt  DateTime? // null until the first-run setup wizard is finished
  assessments  Assessment[]
  profile      Profile?
  teamMemberships TeamMember[]
  prefAnswers  PrefAnswer[]
  meetingsCreated  Meeting[]         @relation("MeetingCreator")
  meetingAttendance MeetingAttendee[]
  thoughts     Thought[]

  @@index([orgId])
}

/// A fleeting idea captured for meeting planning (Phase 2 item 3). Private to
/// its author (only they see it) until it becomes a shared meeting. Can be
/// anchored to a team member (`aboutUserId`, from the Discussion-mode entry
/// point) and, once "structured", links to the Meeting it produced.
///
/// PRIVACY: the "Structure this" AI step sends the thought text plus the team
/// roster's names/titles to Anthropic to draft a meeting shape. It does NOT send
/// anyone's psychometric profile; the working-style prep is computed locally by
/// the deterministic engine on the resulting meeting.
model Thought {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId      String? // which team this is for (defaults to the active team at capture)
  aboutUserId String? // anchored team member, if captured about someone specific
  meetingType String? // optional MeetingTypeCode hint
  text        String // the one-line thought
  detail      String? // optional longer note
  status      String   @default("captured") // captured | planned | archived
  structured  String? // JSON cache of the AI-proposed meeting brief
  meetingId   String? // set once turned into a Meeting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

/// A planned meeting: a real object tied to a team, with a type that shapes the
/// working-style prep and (Phase 2 item 4) an agenda. The generated brief itself
/// is not stored; it is recomputed from the attendees' profiles so it always
/// reflects current data. See docs/phase2-plan.md and lib/meeting-types.ts.
model Meeting {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type         String // MeetingTypeCode (see lib/meeting-types.ts)
  title        String
  goal         String? // what a good outcome looks like (optional, one line)
  scheduledFor DateTime? // the calendar DAY, stored at UTC midnight (a "floating" date, read via UTC getters — see lib/calendar.ts)
  startMinute  Int? // start time as minutes past midnight, wall-clock (null = no set time / all-day). Stored as an offset, not a UTC instant, so it never shifts across timezones.
  durationMin  Int? // meeting length in minutes (null = unset; UI assumes 30 when a time is set)
  createdById  String
  createdBy    User     @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  attendees    MeetingAttendee[]
  agenda       AgendaItem[]

  @@index([teamId])
}

/// One ordered item on a meeting's agenda (Phase 2 item 4). Editable by the
/// meeting's manager; can also be drafted/tightened by Claude from the meeting's
/// type, goal, and attendee names (no psychometric data leaves the app).
model AgendaItem {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  order     Int
  topic     String
  purpose   String   @default("discussion") // decision | discussion | information | brainstorm
  minutes   Int? // optional time-box
  ownerId   String? // an attendee's userId (name resolved in the loader)
  createdAt DateTime @default(now())

  @@index([meetingId])
}

model MeetingAttendee {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
}

/// Admin-editable "working preferences" questions, tailored to the org
/// (seeded for Rise8). These sit ALONGSIDE the fixed IPIP Big Five items: they
/// capture concrete, directly-actionable preferences (channels, response times,
/// escalation) that are shown verbatim on the profile and are NOT psychometrically
/// scored. Admins add/edit/remove them (with Claude's help). See docs/rise8.md.
model PrefQuestion {
  id        String   @id @default(cuid())
  orgId     String
  domain    String // e.g. "Communication", "Feedback" (grouping label)
  prompt    String // the question text, first-person situational
  kind      String   @default("single") // single | multi | scale | text
  options   String   @default("[]") // JSON array of choice labels (for single/multi/scale)
  helpText  String? // optional clarifier shown under the prompt
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  answers   PrefAnswer[]

  @@index([orgId])
}

model PrefAnswer {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   PrefQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String // JSON: string, string[], or number depending on kind
  updatedAt  DateTime     @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
}

model Assessment {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  responses    String    @default("{}") // JSON map: { [itemId]: 1..5 }
  domainScores String? // JSON, computed at completion
  facetScores  String? // JSON, computed at completion
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model Profile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentId       String? // the COMPLETED assessment this profile reflects
  shared             Boolean   @default(false)
  generatedNarrative String? // JSON, canonical machine-written narrative
  editedNarrative    String? // JSON, the user's lightly-edited version (overrides generated when present)
  coaching           String? // JSON, AI coaching plan grounded in this person's own profile (see lib/coach.ts)
  coachingAt         DateTime? // when the coaching plan above was generated
  interpretation     String? // JSON, AI plain-language read of THIS person's own Big Five scores (see lib/interpret.ts)
  interpretationAt   DateTime? // when the interpretation above was generated
  teamRead           String? // JSON, AI read of how this person sits vs the team (aggregate team stats only, see lib/team-read.ts)
  teamReadAt         DateTime? // when the team read above was generated
  teamReadTeamId     String? // the team the read was generated against; regenerate when the active team changes
  refreshedAt        DateTime? // = completedAt of the assessment above; drives the 12-month flag
  updatedAt          DateTime  @updatedAt
}
