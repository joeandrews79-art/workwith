// WorkWith data model.
//
// Local prototype: SQLite (zero setup). For production, change `provider` to
// "postgresql" and point DATABASE_URL at Supabase. Notes on the swap:
//   - `role` and `status` are Strings here because SQLite has no enums. In
//     Postgres you may promote them to real enums.
//   - JSON payloads (responses / scores / narrative) are stored as String
//     (TEXT) for portability; in Postgres you may switch these to Json.
// See README "From local prototype to hosted app".

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the rhel target is what Netlify's Linux functions need.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (transaction) connection, used at runtime
  directUrl = env("DIRECT_URL") // direct/session connection, used for migrations & seed
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
  teams     Team[]
}

model Team {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime     @default(now())
  members   TeamMember[]

  @@index([orgId])
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model User {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String       @unique
  name         String
  title        String? // job title, e.g. "Head of Operations"
  passwordHash String
  role         String       @default("MEMBER") // ADMIN | MEMBER
  mustReset    Boolean      @default(false) // force password change on first login
  createdAt    DateTime     @default(now())
  onboardedAt  DateTime? // null until the first-run setup wizard is finished
  assessments  Assessment[]
  profile      Profile?
  teamMemberships TeamMember[]
  prefAnswers  PrefAnswer[]

  @@index([orgId])
}

/// Admin-editable "working preferences" questions, tailored to the org
/// (seeded for Rise8). These sit ALONGSIDE the fixed IPIP Big Five items: they
/// capture concrete, directly-actionable preferences (channels, response times,
/// escalation) that are shown verbatim on the profile and are NOT psychometrically
/// scored. Admins add/edit/remove them (with Claude's help). See docs/rise8.md.
model PrefQuestion {
  id        String   @id @default(cuid())
  orgId     String
  domain    String // e.g. "Communication", "Feedback" (grouping label)
  prompt    String // the question text, first-person situational
  kind      String   @default("single") // single | multi | scale | text
  options   String   @default("[]") // JSON array of choice labels (for single/multi/scale)
  helpText  String? // optional clarifier shown under the prompt
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  answers   PrefAnswer[]

  @@index([orgId])
}

model PrefAnswer {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   PrefQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      String // JSON: string, string[], or number depending on kind
  updatedAt  DateTime     @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
}

model Assessment {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  responses    String    @default("{}") // JSON map: { [itemId]: 1..5 }
  domainScores String? // JSON, computed at completion
  facetScores  String? // JSON, computed at completion
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

model Profile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentId       String? // the COMPLETED assessment this profile reflects
  shared             Boolean   @default(false)
  generatedNarrative String? // JSON, canonical machine-written narrative
  editedNarrative    String? // JSON, the user's lightly-edited version (overrides generated when present)
  coaching           String? // JSON, AI coaching plan grounded in this person's own profile (see lib/coach.ts)
  coachingAt         DateTime? // when the coaching plan above was generated
  refreshedAt        DateTime? // = completedAt of the assessment above; drives the 12-month flag
  updatedAt          DateTime  @updatedAt
}
